# ---------------------------------------------------------------------------
# Copy to .env and fill in only what you need. .env is gitignored; never commit it.
# Everything below has a working default, so the app runs with no .env at all.
# ---------------------------------------------------------------------------

# Local mock vendor-risk service, started by `python run_local.py`.
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001
VENDOR_RISK_TIMEOUT_SECONDS=3.0

# How the vendor-risk tool reaches that service.
#   http  (default) real network call - what the product does
#   asgi            call the same app in-process - used by tests and evals so a
#                   run needs no port and reproduces anywhere
VENDOR_RISK_TRANSPORT=http

# Which reasoner to use.
#   auto      (default) hosted model if ANTHROPIC_API_KEY is set, else offline
#   anthropic force the hosted model; errors if no key
#   offline   force the local deterministic reasoner (no network, no cost)
LLM_PROVIDER=auto

# Required only for LLM_PROVIDER=anthropic (or auto, to enable the hosted path).
# ANTHROPIC_API_KEY=
# MODEL_NAME=claude-sonnet-5-5
